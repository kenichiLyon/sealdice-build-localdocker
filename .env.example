# 可按需复制为 .env 后再执行 docker compose
# cp .env.docker.example .env

# 默认构建镜像（官方源）
GO_IMAGE=golang:1.25-bookworm
RUNTIME_IMAGE=alpine:3.19.1
RUNTIME_FULL_IMAGE=debian:12-slim
GOPROXY=https://goproxy.cn,direct
APK_MIRROR=mirrors.aliyun.com
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
GITHUB_PROXY=
GITHUB_PROXY_FALLBACKS=https://mirror.ghproxy.com/ https://ghproxy.net/
ARTIFACT_GITHUB_PROXY_FALLBACKS=https://mirror.ghproxy.com/ https://ghproxy.net/

# 产物构建（输出到 ./dist）
ARTIFACT_TARGETS=linux/amd64 linux/arm64 windows/amd64 osx/amd64 osx/arm64
ARTIFACT_ANDROID_TARGETS=android/arm64
ARTIFACT_VERSION=local
ANDROID_NDK_VERSION=r25c
ARTIFACT_VERSION_PRERELEASE=-docker-artifact
ARTIFACT_APP_CHANNEL=dev
ARTIFACT_NT_SIGN_URL=
ARTIFACT_SEAL_TRUSTED_PRIVATE_KEY=
ARTIFACT_CGO_FLAGS=-Werror=unused-variable -Werror=implicit-function-declaration -O2
ARTIFACT_ENABLE_UPX=0
ARTIFACT_BUILTINS_ENABLE=1
ARTIFACT_BUILTINS_REPO=https://github.com/sealdice/sealdice-builtins
ARTIFACT_BUILTINS_REF=master
ARTIFACT_LAGRANGE_ENABLE=1
ARTIFACT_LAGRANGE_BASE_URL=https://d1.sealdice.com/lagrange
ARTIFACT_LAGRANGE_VERSION=0.0.6
ARTIFACT_LAGRANGE_TAG=8.0
ARTIFACT_LAGRANGE_QUERY=v=3
ARTIFACT_ANDROID_APK_ENABLE=0
ARTIFACT_ANDROID_CORE_CGO=1
ARTIFACT_ANDROID_REPO=https://github.com/sealdice/sealdice-android
ARTIFACT_ANDROID_REF=master
ARTIFACT_ANDROID_APP_RUNNER_URL=https://d1.sealdice.com/lagrange/app-runner-std-arm64.tar.gz
ARTIFACT_CLEANUP_MODE=pkg

# 示例：使用镜像站（按你本机可用镜像地址修改）
# GO_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/golang:1.25-bookworm
# RUNTIME_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/alpine:3.19.1
# RUNTIME_FULL_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/debian:12-slim
# GITHUB_PROXY=https://mirror.ghproxy.com/
